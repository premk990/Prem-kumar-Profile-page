<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>S Prem Kumar – Data Engineer & QA Analyst</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet"/>
<style>
:root { --ease: cubic-bezier(0.23, 1, 0.32, 1); }
[data-theme="dark"] {
  --bg:#07080f;--bg2:#0c0e1a;--bg3:#101320;--card:#10132080;--card2:#181b2e;
  --border:rgba(120,100,255,0.18);--text:#eef0ff;--text2:#a8a8cc;--text3:#5e5e8a;
  --accent:#5b8cff;--accent2:#a855f7;--accent3:#f5c518;--gold:#f5c518;
  --grad1:linear-gradient(135deg,#0d1133 0%,#130d2e 45%,#1a100a 100%);
  --grad2:linear-gradient(135deg,#5b8cff 0%,#a855f7 55%,#f5c518 100%);
  --grad3:linear-gradient(135deg,#f5c518 0%,#a855f7 55%,#5b8cff 100%);
  --grad-btn:linear-gradient(135deg,#3a6cf4,#9333ea);
  --glow:0 0 50px rgba(91,140,255,0.2);--shadow:0 4px 24px rgba(0,0,0,0.5);
  --nav-bg:rgba(7,8,15,0.88);
}
[data-theme="light"] {
  --bg:#f5f4ff;--bg2:#eceaff;--bg3:#ffffff;--card:#ffffff;--card2:#f0eeff;
  --border:rgba(100,80,220,0.15);--text:#0e0c2a;--text2:#3a3670;--text3:#7570aa;
  --accent:#3a6cf4;--accent2:#9333ea;--accent3:#b8860b;--gold:#c9970a;
  --grad1:linear-gradient(135deg,#ddd8ff 0%,#f0e6ff 45%,#fff8dc 100%);
  --grad2:linear-gradient(135deg,#3a6cf4 0%,#9333ea 55%,#c9970a 100%);
  --grad3:linear-gradient(135deg,#c9970a 0%,#9333ea 55%,#3a6cf4 100%);
  --grad-btn:linear-gradient(135deg,#3a6cf4,#9333ea);
  --glow:0 0 40px rgba(58,108,244,0.15);--shadow:0 4px 24px rgba(0,0,0,0.1);
  --nav-bg:rgba(245,244,255,0.9);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden;transition:background 0.4s var(--ease),color 0.4s var(--ease);}
a{color:inherit;text-decoration:none;}

body::before{content:'';position:fixed;inset:0;z-index:0;pointer-events:none;
background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");opacity:0.35;}

.blob-wrap{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;}
.blob{position:absolute;border-radius:50%;filter:blur(80px);opacity:0.18;animation:blobFloat 12s ease-in-out infinite;}
.blob-1{width:600px;height:600px;background:#38bdf8;top:-200px;left:-150px;animation-delay:0s;}
.blob-2{width:500px;height:500px;background:#818cf8;bottom:-100px;right:-100px;animation-delay:-4s;}
.blob-3{width:400px;height:400px;background:#34d399;top:40%;left:50%;animation-delay:-8s;}
[data-theme="light"] .blob{opacity:0.09;}
@keyframes blobFloat{0%,100%{transform:translate(0,0) scale(1);}33%{transform:translate(30px,-40px) scale(1.08);}66%{transform:translate(-20px,20px) scale(0.95);}}

nav{position:fixed;top:0;left:0;right:0;z-index:100;background:var(--nav-bg);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);transition:background 0.4s var(--ease);}
.nav-inner{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:0 2rem;height:68px;}
.nav-logo{font-family:'Syne',sans-serif;font-weight:800;font-size:1.4rem;background:var(--grad2);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.nav-links{display:flex;gap:0.2rem;align-items:center;}
.nav-links a{font-size:0.85rem;font-weight:500;color:var(--text2);padding:0.45rem 0.9rem;border-radius:8px;transition:all 0.25s var(--ease);letter-spacing:0.02em;}
.nav-links a:hover,.nav-links a.active{color:var(--accent);background:rgba(56,189,248,0.08);}
.nav-right{display:flex;gap:0.6rem;align-items:center;}
.theme-btn{background:var(--card);border:1px solid var(--border);color:var(--text2);width:40px;height:40px;border-radius:10px;cursor:pointer;font-size:1rem;display:flex;align-items:center;justify-content:center;transition:all 0.25s var(--ease);}
.theme-btn:hover{border-color:var(--accent);color:var(--accent);transform:scale(1.05);}
.btn-hire{background:var(--grad2);color:#fff;border:none;padding:0.5rem 1.3rem;border-radius:10px;font-family:'DM Sans',sans-serif;font-size:0.85rem;font-weight:500;cursor:pointer;transition:all 0.25s var(--ease);box-shadow:0 4px 16px rgba(56,189,248,0.25);}
.btn-hire:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(56,189,248,0.4);}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px;}
.hamburger span{width:24px;height:2px;background:var(--text2);border-radius:2px;transition:all 0.3s;}

section{position:relative;z-index:1;}
.container{max-width:1200px;margin:0 auto;padding:0 2rem;}
.section-pad{padding:100px 0;}
.section-label{font-family:'Syne',sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent);margin-bottom:0.6rem;display:flex;align-items:center;gap:0.6rem;}
.section-label::after{content:'';flex:1;max-width:40px;height:1px;background:var(--accent);opacity:0.5;}
.section-title{font-family:'Syne',sans-serif;font-size:clamp(2rem,4vw,2.8rem);font-weight:800;line-height:1.15;color:var(--text);margin-bottom:1.2rem;}
.section-sub{font-size:1rem;color:var(--text2);max-width:560px;line-height:1.7;}

#hero{min-height:100vh;display:flex;align-items:center;padding-top:68px;background:var(--grad1);}
.hero-inner{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;}
.hero-badge{display:inline-flex;align-items:center;gap:0.5rem;background:rgba(56,189,248,0.1);border:1px solid rgba(56,189,248,0.25);padding:0.4rem 1rem;border-radius:100px;font-size:0.78rem;font-weight:500;color:var(--accent);margin-bottom:1.5rem;animation:fadeSlideUp 0.6s var(--ease) both;}
.hero-badge .dot{width:7px;height:7px;background:var(--accent3);border-radius:50%;animation:pulse 2s ease infinite;}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.5;transform:scale(1.4)}}
.hero-title{font-family:'Syne',sans-serif;font-size:clamp(2.8rem,6vw,4.5rem);font-weight:800;line-height:1.08;margin-bottom:0.5rem;animation:fadeSlideUp 0.7s 0.1s var(--ease) both;}
.hero-title .grad{background:var(--grad2);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.hero-title .grad2{background:var(--grad3);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.hero-role{font-size:1.2rem;color:var(--text2);margin-bottom:1.2rem;font-weight:300;animation:fadeSlideUp 0.7s 0.2s var(--ease) both;}
.hero-desc{color:var(--text2);line-height:1.75;margin-bottom:2rem;font-size:1rem;max-width:480px;animation:fadeSlideUp 0.7s 0.3s var(--ease) both;}
.hero-ctas{display:flex;gap:1rem;flex-wrap:wrap;animation:fadeSlideUp 0.7s 0.4s var(--ease) both;}
.btn-primary{background:var(--grad2);color:#fff;border:none;padding:0.85rem 2rem;border-radius:12px;font-family:'DM Sans',sans-serif;font-size:0.95rem;font-weight:500;cursor:pointer;transition:all 0.3s var(--ease);box-shadow:0 4px 20px rgba(56,189,248,0.3);display:inline-flex;align-items:center;gap:0.5rem;}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 8px 32px rgba(56,189,248,0.45);}
.btn-secondary{background:transparent;color:var(--text);border:1px solid var(--border);padding:0.85rem 2rem;border-radius:12px;font-family:'DM Sans',sans-serif;font-size:0.95rem;font-weight:500;cursor:pointer;transition:all 0.3s var(--ease);display:inline-flex;align-items:center;gap:0.5rem;}
.btn-secondary:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-3px);}
.hero-stats{display:flex;gap:2.5rem;margin-top:2.5rem;animation:fadeSlideUp 0.7s 0.5s var(--ease) both;}
.stat-num{font-family:'Syne',sans-serif;font-size:2rem;font-weight:800;background:var(--grad2);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.stat-label{font-size:0.8rem;color:var(--text3);font-weight:400;margin-top:0.1rem;}
.hero-visual{display:flex;justify-content:center;align-items:center;animation:fadeSlideUp 0.9s 0.2s var(--ease) both;}
.avatar-wrap{position:relative;width:340px;height:340px;}
.avatar-ring{position:absolute;inset:0;border-radius:50%;background:conic-gradient(from 0deg,#38bdf8,#818cf8,#34d399,#38bdf8);animation:spinRing 6s linear infinite;padding:3px;}
@keyframes spinRing{to{transform:rotate(360deg);}}
.avatar-inner{position:absolute;inset:3px;border-radius:50%;background:var(--grad1);display:flex;align-items:center;justify-content:center;overflow:hidden;}
.avatar-initials{font-family:'Syne',sans-serif;font-size:5rem;font-weight:800;background:var(--grad2);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.avatar-badge{position:absolute;bottom:20px;right:-10px;background:var(--card);border:1px solid var(--border);border-radius:14px;padding:0.7rem 1.1rem;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:2px;min-width:140px;}
.ab-top{font-size:0.7rem;color:var(--text3);}
.ab-bot{font-family:'Syne',sans-serif;font-size:0.95rem;font-weight:700;color:var(--accent3);}
.avatar-badge2{position:absolute;top:30px;left:-20px;background:var(--card);border:1px solid var(--border);border-radius:14px;padding:0.7rem 1.1rem;box-shadow:var(--shadow);display:flex;align-items:center;gap:0.6rem;min-width:130px;}
.ab2-icon{font-size:1.3rem;}
.ab2-text{font-size:0.75rem;color:var(--text2);font-weight:500;}
.ab2-sub{font-size:0.68rem;color:var(--text3);}

#about{background:var(--bg2);}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:start;}
.about-highlights{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1.5rem;}
.highlight-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:1.2rem;transition:all 0.3s var(--ease);}
.highlight-card:hover{border-color:var(--accent);transform:translateY(-4px);box-shadow:var(--glow);}
.hl-icon{font-size:1.5rem;margin-bottom:0.5rem;}
.hl-num{font-family:'Syne',sans-serif;font-size:1.6rem;font-weight:800;background:var(--grad2);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.hl-text{font-size:0.8rem;color:var(--text3);margin-top:0.2rem;}
.about-right{display:flex;flex-direction:column;gap:1.2rem;}
.info-row{display:flex;align-items:center;gap:1rem;padding:1rem 1.2rem;background:var(--card);border:1px solid var(--border);border-radius:14px;transition:all 0.25s var(--ease);}
.info-row:hover{border-color:var(--accent2);}
.info-icon{font-size:1.2rem;width:36px;text-align:center;flex-shrink:0;}
.info-label{font-size:0.75rem;color:var(--text3);margin-bottom:0.15rem;}
.info-val{font-size:0.9rem;font-weight:500;color:var(--text);}
.info-val a{color:var(--accent);}
.info-val a:hover{text-decoration:underline;}

#skills{background:var(--bg);}
.skills-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1.5rem;margin-top:3rem;}
.skill-card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:1.8rem;transition:all 0.35s var(--ease);position:relative;overflow:hidden;}
.skill-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--grad2);opacity:0;transition:opacity 0.3s;}
.skill-card:hover::before{opacity:1;}
.skill-card:hover{border-color:var(--accent);transform:translateY(-6px);box-shadow:var(--glow);}
.skill-cat{font-family:'Syne',sans-serif;font-size:0.7rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--accent);margin-bottom:1rem;}
.skill-title{font-family:'Syne',sans-serif;font-size:1.1rem;font-weight:700;margin-bottom:1.2rem;}
.skill-tags{display:flex;flex-wrap:wrap;gap:0.5rem;}
.tag{font-size:0.78rem;padding:0.35rem 0.8rem;border-radius:8px;background:var(--card2);border:1px solid var(--border);color:var(--text2);transition:all 0.2s;}
.tag:hover{background:rgba(56,189,248,0.1);border-color:var(--accent);color:var(--accent);}

#experience{background:var(--bg2);}
.exp-timeline{position:relative;padding-left:2rem;}
.exp-timeline::before{content:'';position:absolute;left:0;top:8px;bottom:8px;width:2px;background:linear-gradient(to bottom,var(--accent),var(--accent2),transparent);border-radius:2px;}
.exp-item{position:relative;margin-bottom:3rem;}
.exp-dot{position:absolute;left:-2.45rem;top:6px;width:16px;height:16px;border-radius:50%;background:var(--grad2);border:3px solid var(--bg2);box-shadow:0 0 0 3px rgba(56,189,248,0.2);}
.exp-card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:2rem;transition:all 0.35s var(--ease);}
.exp-card:hover{border-color:var(--accent);transform:translateX(6px);box-shadow:var(--glow);}
.exp-meta{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap;margin-bottom:0.8rem;}
.exp-company{font-family:'Syne',sans-serif;font-size:1.2rem;font-weight:800;color:var(--text);}
.exp-period{font-size:0.8rem;background:rgba(56,189,248,0.1);color:var(--accent);padding:0.3rem 0.8rem;border-radius:8px;border:1px solid rgba(56,189,248,0.2);font-weight:500;white-space:nowrap;}
.exp-role{font-size:0.9rem;color:var(--accent3);font-weight:500;margin-bottom:1rem;}
.exp-desc{font-size:0.9rem;color:var(--text2);line-height:1.7;margin-bottom:1rem;}
.exp-bullets{list-style:none;display:flex;flex-direction:column;gap:0.5rem;}
.exp-bullets li{font-size:0.875rem;color:var(--text2);line-height:1.6;padding-left:1.2rem;position:relative;}
.exp-bullets li::before{content:'▸';position:absolute;left:0;color:var(--accent);}

#projects{background:var(--bg);}
.projects-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:1.5rem;margin-top:3rem;}
.project-card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:2rem;transition:all 0.35s var(--ease);display:flex;flex-direction:column;gap:1rem;position:relative;overflow:hidden;}
.project-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:var(--grad3);transform:scaleX(0);transform-origin:left;transition:transform 0.4s var(--ease);}
.project-card:hover::after{transform:scaleX(1);}
.project-card:hover{border-color:var(--accent3);transform:translateY(-6px);box-shadow:0 0 40px rgba(52,211,153,0.12);}
.project-header{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;}
.project-icon{font-size:2rem;}
.project-period{font-size:0.75rem;color:var(--text3);background:var(--card2);padding:0.3rem 0.7rem;border-radius:8px;}
.project-domain{font-size:0.72rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--accent3);margin-bottom:0.3rem;}
.project-name{font-family:'Syne',sans-serif;font-size:1.05rem;font-weight:700;color:var(--text);}
.project-role{font-size:0.8rem;color:var(--text3);margin-top:0.25rem;}
.project-desc{font-size:0.875rem;color:var(--text2);line-height:1.65;}
.project-stack{display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:auto;}
.stack-tag{font-size:0.72rem;padding:0.25rem 0.65rem;border-radius:6px;background:rgba(52,211,153,0.08);border:1px solid rgba(52,211,153,0.2);color:var(--accent3);}
.project-impact{font-size:0.8rem;color:var(--gold);background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.2);padding:0.6rem 0.9rem;border-radius:10px;display:flex;align-items:center;gap:0.4rem;}

#certifications{background:var(--bg2);}
.cert-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;margin-top:3rem;}
.cert-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:1.3rem 1.5rem;display:flex;align-items:center;gap:1rem;transition:all 0.3s var(--ease);}
.cert-card:hover{border-color:var(--gold);transform:translateY(-4px);box-shadow:0 0 30px rgba(251,191,36,0.1);}
.cert-icon{font-size:1.8rem;flex-shrink:0;}
.cert-name{font-size:0.88rem;font-weight:600;color:var(--text);line-height:1.4;}
.cert-issuer{font-size:0.75rem;color:var(--text3);margin-top:0.2rem;}

#education{background:var(--bg);}
.edu-card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:2.5rem;display:flex;gap:2rem;align-items:flex-start;max-width:700px;transition:all 0.35s var(--ease);}
.edu-card:hover{border-color:var(--accent2);box-shadow:var(--glow);}
.edu-icon{font-size:3rem;flex-shrink:0;}
.edu-degree{font-family:'Syne',sans-serif;font-size:1.3rem;font-weight:800;}
.edu-univ{color:var(--accent2);font-size:0.9rem;margin:0.3rem 0;}
.edu-meta{display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.8rem;}
.edu-pill{font-size:0.78rem;padding:0.3rem 0.8rem;border-radius:8px;background:var(--card2);border:1px solid var(--border);color:var(--text2);}
.edu-pill.gold{border-color:rgba(251,191,36,0.3);color:var(--gold);background:rgba(251,191,36,0.06);}

#contact{background:var(--bg2);}
.contact-inner{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:start;}
.contact-links{display:flex;flex-direction:column;gap:1rem;margin-top:1.5rem;}
.contact-link{display:flex;align-items:center;gap:1rem;padding:1.2rem 1.5rem;background:var(--card);border:1px solid var(--border);border-radius:16px;text-decoration:none;transition:all 0.3s var(--ease);}
.contact-link:hover{border-color:var(--accent);transform:translateX(6px);box-shadow:var(--glow);}
.cl-icon{font-size:1.4rem;width:40px;text-align:center;flex-shrink:0;}
.cl-label{font-size:0.75rem;color:var(--text3);margin-bottom:0.15rem;}
.cl-val{font-size:0.9rem;font-weight:500;color:var(--accent);}
.contact-form-wrap{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:2rem;}
.form-title{font-family:'Syne',sans-serif;font-size:1.2rem;font-weight:700;margin-bottom:1.5rem;}
.form-group{margin-bottom:1.2rem;}
.form-group label{display:block;font-size:0.8rem;color:var(--text3);margin-bottom:0.5rem;font-weight:500;}
.form-group input,.form-group textarea{width:100%;background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:0.8rem 1rem;font-family:'DM Sans',sans-serif;font-size:0.9rem;color:var(--text);outline:none;transition:all 0.25s var(--ease);resize:vertical;}
.form-group input:focus,.form-group textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(56,189,248,0.1);}
.form-group textarea{min-height:110px;}
.form-submit{width:100%;background:var(--grad2);color:#fff;border:none;padding:0.9rem;border-radius:12px;font-family:'DM Sans',sans-serif;font-size:1rem;font-weight:500;cursor:pointer;transition:all 0.3s var(--ease);}
.form-submit:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(56,189,248,0.35);}
.form-toast{display:none;margin-top:1rem;padding:0.8rem 1rem;border-radius:10px;background:rgba(52,211,153,0.1);border:1px solid rgba(52,211,153,0.3);color:var(--accent3);font-size:0.875rem;text-align:center;}

footer{background:var(--bg);border-top:1px solid var(--border);padding:2rem 0;text-align:center;position:relative;z-index:1;}
.footer-text{font-size:0.85rem;color:var(--text3);}
.footer-text span{color:var(--accent);}
.scroll-top{position:fixed;bottom:2rem;right:2rem;z-index:90;width:48px;height:48px;border-radius:14px;background:var(--grad2);border:none;color:#fff;font-size:1.2rem;cursor:pointer;box-shadow:0 4px 20px rgba(56,189,248,0.3);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:all 0.3s var(--ease);transform:translateY(20px);}
.scroll-top.visible{opacity:1;pointer-events:auto;transform:translateY(0);}
